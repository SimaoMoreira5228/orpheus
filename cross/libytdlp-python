#!/bin/sh

if [ "$1" = "-c" ] \
	&& [ "$2" = "import sysconfig; print(sysconfig.get_config_var('LIBDIR')); print('python' + sysconfig.get_config_var('LDVERSION'))" ]; then
	version=$(/usr/bin/python3 -c "import sysconfig; print(sysconfig.get_config_var('LDVERSION'))")
	printf '%s\n' "/usr/lib/aarch64-linux-gnu" "python${version}"
	exit 0
fi

exec /usr/bin/python3 "$@"
